{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronicle.local/schemas/editorial.candidate_decision.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "chronicle.editorial.candidate_decision/1"
    },
    "subject": {
      "$ref": "common.json#/$defs/TechRef"
    },
    "decision": {
      "enum": [
        "shortlisted",
        "accepted",
        "rejected",
        "deferred"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "entity": {
      "$ref": "common.json#/$defs/ChronicleId"
    },
    "evidence_fingerprint": {
      "$ref": "common.json#/$defs/Fingerprint"
    },
    "resurface": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": {
          "enum": [
            "never",
            "on_signal_change"
          ]
        },
        "threshold": {
          "type": "number"
        }
      },
      "required": [
        "policy"
      ]
    },
    "by": {
      "type": "string",
      "minLength": 1
    },
    "at": {
      "$ref": "common.json#/$defs/DateText"
    }
  },
  "required": [
    "schema",
    "subject",
    "decision",
    "evidence_fingerprint",
    "by",
    "at"
  ],
  "title": "Decisión sobre un candidato (Fase 16, 7.7)",
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "accepted"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "required": [
          "entity"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "not": {
              "const": "shortlisted"
            }
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "required": [
          "reason"
        ]
      }
    }
  ]
}
