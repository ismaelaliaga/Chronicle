{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronicle.local/schemas/editorial.candidate_decision.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "chronicle.editorial.candidate_decision/2"
    },
    "subject": {
      "$ref": "common.json#/$defs/TechRef"
    },
    "decision": {
      "enum": [
        "shortlisted",
        "accepted",
        "rejected",
        "deferred"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "entity": {
      "$ref": "common.json#/$defs/ChronicleId"
    },
    "evidence_fingerprint": {
      "$ref": "common.json#/$defs/Fingerprint"
    },
    "resurface": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": {
          "enum": [
            "never",
            "on_signal_change"
          ]
        },
        "threshold": {
          "type": "number"
        }
      },
      "required": [
        "policy"
      ]
    },
    "by": {
      "type": "string",
      "minLength": 1
    },
    "at": {
      "$ref": "common.json#/$defs/DateText"
    },
    "inclusion_reasons": {
      "type": "array",
      "items": {
        "enum": [
          "own_story",
          "lore_presence",
          "event_participant",
          "relevant_quest",
          "leadership",
          "represents_group_or_place",
          "zone_context",
          "memorable"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "reject_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "duplicate_of": {
      "$ref": "common.json#/$defs/TechRef"
    },
    "defer_reason": {
      "enum": [
        "insufficient_evidence",
        "awaiting_source_policy",
        "awaiting_client_data",
        "awaiting_editorial_review"
      ]
    },
    "policy_version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "schema",
    "subject",
    "decision",
    "evidence_fingerprint",
    "policy_version",
    "by",
    "at"
  ],
  "title": "Decisión sobre un candidato (Fase 16, 7.7; v2 de Fase 18). accepted = decisión editorial positiva; NO implica Binding, publicación técnica ni Discovery",
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "accepted"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "required": [
          "entity",
          "inclusion_reasons"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "reject_reasons"
              ]
            },
            {
              "required": [
                "defer_reason"
              ]
            },
            {
              "required": [
                "duplicate_of"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "rejected"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "required": [
          "reject_reasons"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "inclusion_reasons"
              ]
            },
            {
              "required": [
                "entity"
              ]
            },
            {
              "required": [
                "defer_reason"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "deferred"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "required": [
          "defer_reason"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "inclusion_reasons"
              ]
            },
            {
              "required": [
                "entity"
              ]
            },
            {
              "required": [
                "reject_reasons"
              ]
            },
            {
              "required": [
                "duplicate_of"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "shortlisted"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "inclusion_reasons"
              ]
            },
            {
              "required": [
                "entity"
              ]
            },
            {
              "required": [
                "reject_reasons"
              ]
            },
            {
              "required": [
                "defer_reason"
              ]
            },
            {
              "required": [
                "duplicate_of"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "reject_reasons": {
            "contains": {
              "const": "duplicate_of"
            }
          }
        },
        "required": [
          "reject_reasons"
        ]
      },
      "then": {
        "required": [
          "duplicate_of"
        ]
      }
    }
  ]
}
