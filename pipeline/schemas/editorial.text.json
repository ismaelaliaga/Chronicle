{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronicle.local/schemas/editorial.text.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "chronicle.editorial.text/1"
    },
    "locale": {
      "$ref": "common.json#/$defs/Locale"
    },
    "entries": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^((continent|zone|city|subzone|npc|lore)|hint):[a-z0-9]+(_[a-z0-9]+)*$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "body": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "type": "string",
              "minLength": 1
            },
            "race": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [],
          "minProperties": 1
        }
      }
    }
  },
  "required": [
    "schema",
    "locale",
    "entries"
  ],
  "title": "Textos por idioma (Fase 16, 7.6)"
}
