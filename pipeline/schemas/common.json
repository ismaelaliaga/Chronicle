      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "conflict"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            },
            "required": [
              "conflict"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
